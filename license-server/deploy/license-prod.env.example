# Dewu License PROD environment
LICENSE_PORT=8080
LICENSE_DB_PATH=/data/dewu-license/data/license.db
LICENSE_LOG_FILE=/data/dewu-license/logs/app.log

# Keep PROD payment disabled until real Alipay/WeChat provider credentials are configured.
LICENSE_PAYMENT_MODE=disabled

# Replace before production use.
LICENSE_ADMIN_TOKEN=change-this-production-token
