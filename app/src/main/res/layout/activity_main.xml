<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F5F6"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="得物自动报名 V1"
                android:textColor="#15191C"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRuntimeStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="等待开始"
                android:textColor="#687278"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="#FFFFFF"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp">

            <TextView
                android:id="@+id/tvAccessibility"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="● 无障碍  未开启"
                android:textColor="#687278"
                android:textSize="14sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:background="#DFE4E6" />

            <TextView
                android:id="@+id/tvDewuVersion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="得物  未检测"
                android:textColor="#30373B"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:background="@drawable/bg_notice_safety"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="安全模式"
                android:src="@drawable/ic_shield"
                android:tint="#C66A00" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="自动报名后无法取消"
                    android:textColor="#B96200"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="仅在列表与详情双重筛选通过后提交；遇到未知页面立即停止"
                    android:textColor="#8D5C25"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvAccountNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:background="@drawable/bg_notice_account"
            android:padding="16dp"
            android:text="达人号将通过“我 → 商单”快捷入口进入；不会点击申请入驻"
            android:textColor="#995B20"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="常用筛选"
                android:textColor="#15191C"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="用于判断任务是否符合要求"
                android:textColor="#687278"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="104dp"
                    android:layout_height="wrap_content"
                    android:text="产品类目"
                    android:textColor="#30373B"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spCategory"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DFE4E6" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="104dp"
                    android:layout_height="wrap_content"
                    android:text="排序方式"
                    android:textColor="#30373B"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spSortMode"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DFE4E6" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="104dp"
                    android:layout_height="wrap_content"
                    android:text="奖励范围"
                    android:textColor="#30373B"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etMinPrice"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:text="21"
                    android:textColor="#15191C"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="至"
                    android:textColor="#687278" />

                <EditText
                    android:id="@+id/etMaxPrice"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:text="9999999"
                    android:textColor="#15191C"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="元"
                    android:textColor="#687278" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DFE4E6" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <TextView
                    android:layout_width="104dp"
                    android:layout_height="wrap_content"
                    android:text="排除词"
                    android:textColor="#30373B"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/etExcludedWords"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_input"
                        android:gravity="center_vertical"
                        android:hint="用逗号或 ## 分隔"
                        android:paddingHorizontal="12dp"
                        android:singleLine="true"
                        android:text="内定,复投,直接报名,订阅提醒,定制,露脸,真人出镜,出镜,拍视频,视频拍摄,口播,直播"
                        android:textColor="#15191C"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="支持逗号、中文逗号或 ## 分隔"
                        android:textColor="#687278"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DFE4E6" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <TextView
                    android:layout_width="104dp"
                    android:layout_height="wrap_content"
                    android:text="样品规格"
                    android:textColor="#30373B"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/etSizeSpec"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_input"
                        android:gravity="center_vertical"
                        android:hint="例如：L码，42码"
                        android:inputType="text"
                        android:paddingHorizontal="12dp"
                        android:singleLine="true"
                        android:textColor="#15191C"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="必填；报名页优先选择第一个匹配规格"
                        android:textColor="#687278"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/advancedHeader"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="循环与执行设置"
                    android:textColor="#15191C"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAdvancedSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="下滑 5 次 · 刷新 2–10 秒"
                    android:textColor="#687278"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivAdvancedChevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="展开循环与执行设置"
                android:src="@drawable/ic_chevron"
                android:tint="#687278" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/advancedPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="18dp"
            android:visibility="gone">

            <TextView style="@style/ExecutionFieldLabel" android:text="目标报名成功次数" />
            <EditText android:id="@+id/etTargetEnrollments" style="@style/ExecutionFieldInput" android:inputType="number" android:text="1" />
            <TextView style="@style/ExecutionFieldLabel" android:text="每种排序最大下滑次数" />
            <EditText android:id="@+id/etMaxScrolls" style="@style/ExecutionFieldInput" android:inputType="number" android:text="5" />
            <TextView style="@style/ExecutionFieldLabel" android:text="页面刷新等待（最小秒）" />
            <EditText android:id="@+id/etRefreshMin" style="@style/ExecutionFieldInput" android:inputType="number" android:text="2" />
            <TextView style="@style/ExecutionFieldLabel" android:text="页面刷新等待（最大秒）" />
            <EditText android:id="@+id/etRefreshMax" style="@style/ExecutionFieldInput" android:inputType="number" android:text="10" />
            <TextView style="@style/ExecutionFieldLabel" android:text="每轮首页作品数量（0 跳过）" />
            <EditText android:id="@+id/etHomeBrowseCount" style="@style/ExecutionFieldInput" android:inputType="number" android:text="1" />
            <TextView style="@style/ExecutionFieldLabel" android:text="轮次休息（最小分钟）" />
            <EditText android:id="@+id/etRestMin" style="@style/ExecutionFieldInput" android:inputType="number" android:text="0" />
            <TextView style="@style/ExecutionFieldLabel" android:text="轮次休息（最大分钟）" />
            <EditText android:id="@+id/etRestMax" style="@style/ExecutionFieldInput" android:inputType="number" android:text="0" />
            <TextView style="@style/ExecutionFieldLabel" android:text="图文滑动（最小次数）" />
            <EditText android:id="@+id/etImageSwipeMin" style="@style/ExecutionFieldInput" android:inputType="number" android:text="1" />
            <TextView style="@style/ExecutionFieldLabel" android:text="图文滑动（最大次数）" />
            <EditText android:id="@+id/etImageSwipeMax" style="@style/ExecutionFieldInput" android:inputType="number" android:text="8" />
            <TextView style="@style/ExecutionFieldLabel" android:text="视频停留（最小秒）" />
            <EditText android:id="@+id/etVideoStayMin" style="@style/ExecutionFieldInput" android:inputType="number" android:text="5" />
            <TextView style="@style/ExecutionFieldLabel" android:text="视频停留（最大秒）" />
            <EditText android:id="@+id/etVideoStayMax" style="@style/ExecutionFieldInput" android:inputType="number" android:text="10" />
            <TextView style="@style/ExecutionFieldLabel" android:text="卡密（Debug 可留空）" />
            <EditText android:id="@+id/etCardKey" style="@style/ExecutionFieldInput" android:inputType="text" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/cbIrreversibleAck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFF7EA"
            android:buttonTint="#C66A00"
            android:padding="16dp"
            android:text="我已确认：任务报名后无法取消，筛选通过后允许自动提交"
            android:textColor="#8D5C25"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="#079CA3"
                android:text="开始自动报名"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStop"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#FFFFFF"
                android:text="停止任务"
                android:textAllCaps="false"
                android:textColor="#067F85"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                app:strokeColor="#079CA3"
                app:strokeWidth="1dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton android:id="@+id/btnAccessibility" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:backgroundTint="#EDF1F2" android:text="无障碍设置" android:textAllCaps="false" android:textColor="#4F575B" android:textSize="12sp" app:cornerRadius="7dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnOpenDewu" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="8dp" android:layout_weight="1" android:backgroundTint="#EDF1F2" android:text="仅打开得物" android:textAllCaps="false" android:textColor="#4F575B" android:textSize="12sp" app:cornerRadius="7dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="扫描结果" android:textColor="#15191C" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="最近一次页面解析" android:textColor="#687278" android:textSize="12sp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="82dp" android:gravity="center" android:orientation="horizontal">
                <TextView android:id="@+id/tvScannedCount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="已扫描\n0" android:textColor="#15191C" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvEligibleCount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="符合\n0" android:textColor="#2D9C33" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvEnrollmentSuccessCount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="已报名\n0" android:textColor="#067F85" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvExcludedCount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="已跳过\n0" android:textColor="#15191C" android:textSize="16sp" android:textStyle="bold" />
            </LinearLayout>

            <TextView android:id="@+id/tvResultOne" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_result_neutral" android:padding="14dp" android:text="尚无扫描结果" android:textColor="#687278" android:textSize="13sp" />
            <TextView android:id="@+id/tvResultTwo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_result_neutral" android:padding="14dp" android:text="启动后显示筛选、详情复核与报名状态" android:textColor="#687278" android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvScreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="18dp"
            android:text="自动报名 V1 · 不会点击申请入驻"
            android:textColor="#687278"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
