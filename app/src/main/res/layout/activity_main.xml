<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F5F6"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="#15191C"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRuntimeStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="等待开始"
                android:textColor="#687278"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="#FFFFFF"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp">

            <TextView
                android:id="@+id/tvAccessibility"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="● 无障碍  未开启"
                android:textColor="#687278"
                android:textSize="14sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:background="#DFE4E6" />

            <TextView
                android:id="@+id/tvDewuVersion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="得物  未检测"
                android:textColor="#30373B"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:background="@drawable/bg_notice_safety"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="安全模式"
                android:src="@drawable/ic_shield"
                android:tint="#C66A00" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="最终确认报名后无法取消"
                    android:textColor="#B96200"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="默认演练会在最终弹窗取消；仅本轮人工开启后才会真实确认"
                    android:textColor="#8D5C25"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvAccountNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:background="@drawable/bg_notice_account"
            android:padding="16dp"
            android:text="达人号将通过“我 → 商单”快捷入口进入；不会点击申请入驻"
            android:textColor="#995B20"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="常用筛选"
                android:textColor="#15191C"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="用于判断任务是否符合要求"
                android:textColor="#687278"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="104dp"
                    android:layout_height="wrap_content"
                    android:text="产品类目"
                    android:textColor="#30373B"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spCategory"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DFE4E6" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="104dp"
                    android:layout_height="wrap_content"
                    android:text="排序方式"
                    android:textColor="#30373B"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spSortMode"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DFE4E6" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="104dp"
                    android:layout_height="wrap_content"
                    android:text="奖励范围"
                    android:textColor="#30373B"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etMinPrice"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:text="21"
                    android:textColor="#15191C"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="至"
                    android:textColor="#687278" />

                <EditText
                    android:id="@+id/etMaxPrice"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:text="9999999"
                    android:textColor="#15191C"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="元"
                    android:textColor="#687278" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DFE4E6" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <TextView
                    android:layout_width="104dp"
                    android:layout_height="wrap_content"
                    android:text="排除词"
                    android:textColor="#30373B"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/etExcludedWords"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_input"
                        android:gravity="center_vertical"
                        android:hint="例如：口播,寄回；用逗号或 ## 分隔"
                        android:paddingHorizontal="12dp"
                        android:singleLine="true"
                        android:textColor="#15191C"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="支持逗号、中文逗号或 ## 分隔"
                        android:textColor="#687278"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DFE4E6" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <TextView
                    android:layout_width="104dp"
                    android:layout_height="wrap_content"
                    android:text="样品规格"
                    android:textColor="#30373B"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/etSizeSpec"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_input"
                        android:gravity="center_vertical"
                        android:hint="例如：L码，42码"
                        android:inputType="text"
                        android:paddingHorizontal="12dp"
                        android:singleLine="true"
                        android:textColor="#15191C"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="必填；报名页优先选择第一个匹配规格"
                        android:textColor="#687278"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="固定安全规则"
                android:textColor="#15191C"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="• 仅视频任务直接跳过\n• 必须露脸直接跳过\n• 提到露脸但明确可选上身不露脸时通过\n• 达人要求通过后继续检查拍摄要求\n• 订阅提醒只记录，绝不点击"
                android:textColor="#4F575B"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="执行范围"
                android:textColor="#15191C"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView style="@style/ExecutionFieldLabel" android:text="目标处理任务数" />
            <EditText android:id="@+id/etTargetEnrollments" style="@style/ExecutionFieldInput" android:inputType="number" android:text="1" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="达到该数量后停止；演练与真实报名分别计数"
                android:textColor="#687278"
                android:textSize="11sp" />

            <TextView style="@style/ExecutionFieldLabel" android:text="最大下滑次数" />
            <EditText android:id="@+id/etMaxScrolls" style="@style/ExecutionFieldInput" android:inputType="number" android:text="5" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="当前排序从顶部扫描后，列表最多再向下滑动的次数"
                android:textColor="#687278"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="授权"
                android:textColor="#15191C"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView style="@style/ExecutionFieldLabel" android:text="卡密（Debug 可留空）" />
            <EditText android:id="@+id/etCardKey" style="@style/ExecutionFieldInput" android:inputType="text" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFinalConfirmationMode"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="14dp"
            android:backgroundTint="#FFFFFF"
            android:text="最终确认报名：未开启"
            android:textAllCaps="false"
            android:textColor="#B96200"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            app:strokeColor="#C66A00"
            app:strokeWidth="1dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="#079CA3"
                android:text="开始执行"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStop"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#FFFFFF"
                android:text="停止任务"
                android:textAllCaps="false"
                android:textColor="#067F85"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                app:strokeColor="#079CA3"
                app:strokeWidth="1dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton android:id="@+id/btnAccessibility" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:backgroundTint="#EDF1F2" android:text="无障碍设置" android:textAllCaps="false" android:textColor="#4F575B" android:textSize="12sp" app:cornerRadius="7dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnOpenDewu" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="8dp" android:layout_weight="1" android:backgroundTint="#EDF1F2" android:text="仅打开得物" android:textAllCaps="false" android:textColor="#4F575B" android:textSize="12sp" app:cornerRadius="7dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="扫描结果" android:textColor="#15191C" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="本轮全部任务；状态变化会更新原记录" android:textColor="#687278" android:textSize="12sp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="82dp" android:gravity="center" android:orientation="horizontal">
                <TextView android:id="@+id/tvScannedCount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="已扫描\n0" android:textColor="#15191C" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvEligibleCount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="符合\n0" android:textColor="#2D9C33" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvEnrollmentSuccessCount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="已报名\n0" android:textColor="#067F85" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvExcludedCount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="已跳过\n0" android:textColor="#15191C" android:textSize="16sp" android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvResultEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_result_neutral"
                android:padding="14dp"
                android:text="尚无扫描结果"
                android:textColor="#687278"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/resultList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvScreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="18dp"
            android:text="自动报名 V1.4 · 默认演练，不点击申请入驻"
            android:textColor="#687278"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
